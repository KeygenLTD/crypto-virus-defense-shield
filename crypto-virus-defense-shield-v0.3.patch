+"""Conservative AES expanded-key schedule detection for captured process memory."""
+
+from __future__ import annotations
+
+from dataclasses import asdict, dataclass
+
+# fmt: off
+SBOX = bytes(
+    [
+        0x63, 0x7C, 0x77, 0x7B, 0xF2, 0x6B, 0x6F, 0xC5, 0x30, 0x01, 0x67, 0x2B, 0xFE, 0xD7, 0xAB, 0x76,
+        0xCA, 0x82, 0xC9, 0x7D, 0xFA, 0x59, 0x47, 0xF0, 0xAD, 0xD4, 0xA2, 0xAF, 0x9C, 0xA4, 0x72, 0xC0,
+        0xB7, 0xFD, 0x93, 0x26, 0x36, 0x3F, 0xF7, 0xCC, 0x34, 0xA5, 0xE5, 0xF1, 0x71, 0xD8, 0x31, 0x15,
+        0x04, 0xC7, 0x23, 0xC3, 0x18, 0x96, 0x05, 0x9A, 0x07, 0x12, 0x80, 0xE2, 0xEB, 0x27, 0xB2, 0x75,
+        0x09, 0x83, 0x2C, 0x1A, 0x1B, 0x6E, 0x5A, 0xA0, 0x52, 0x3B, 0xD6, 0xB3, 0x29, 0xE3, 0x2F, 0x84,
+        0x53, 0xD1, 0x00, 0xED, 0x20, 0xFC, 0xB1, 0x5B, 0x6A, 0xCB, 0xBE, 0x39, 0x4A, 0x4C, 0x58, 0xCF,
+        0xD0, 0xEF, 0xAA, 0xFB, 0x43, 0x4D, 0x33, 0x85, 0x45, 0xF9, 0x02, 0x7F, 0x50, 0x3C, 0x9F, 0xA8,
+        0x51, 0xA3, 0x40, 0x8F, 0x92, 0x9D, 0x38, 0xF5, 0xBC, 0xB6, 0xDA, 0x21, 0x10, 0xFF, 0xF3, 0xD2,
+        0xCD, 0x0C, 0x13, 0xEC, 0x5F, 0x97, 0x44, 0x17, 0xC4, 0xA7, 0x7E, 0x3D, 0x64, 0x5D, 0x19, 0x73,
+        0x60, 0x81, 0x4F, 0xDC, 0x22, 0x2A, 0x90, 0x88, 0x46, 0xEE, 0xB8, 0x14, 0xDE, 0x5E, 0x0B, 0xDB,
+        0xE0, 0x32, 0x3A, 0x0A, 0x49, 0x06, 0x24, 0x5C, 0xC2, 0xD3, 0xAC, 0x62, 0x91, 0x95, 0xE4, 0x79,
+        0xE7, 0xC8, 0x37, 0x6D, 0x8D, 0xD5, 0x4E, 0xA9, 0x6C, 0x56, 0xF4, 0xEA, 0x65, 0x7A, 0xAE, 0x08,
+        0xBA, 0x78, 0x25, 0x2E, 0x1C, 0xA6, 0xB4, 0xC6, 0xE8, 0xDD, 0x74, 0x1F, 0x4B, 0xBD, 0x8B, 0x8A,
+        0x70, 0x3E, 0xB5, 0x66, 0x48, 0x03, 0xF6, 0x0E, 0x61, 0x35, 0x57, 0xB9, 0x86, 0xC1, 0x1D, 0x9E,
+        0xE1, 0xF8, 0x98, 0x11, 0x69, 0xD9, 0x8E, 0x94, 0x9B, 0x1E, 0x87, 0xE9, 0xCE, 0x55, 0x28, 0xDF,
+        0x8C, 0xA1, 0x89, 0x0D, 0xBF, 0xE6, 0x42, 0x68, 0x41, 0x99, 0x2D, 0x0F, 0xB0, 0x54, 0xBB, 0x16,
+    ]
+)
+# fmt: on
+
+RCON = (0x00, 0x01, 0x02, 0x04, 0x08, 0x10, 0x20, 0x40, 0x80, 0x1B, 0x36)
+
+
+@dataclass(frozen=True)
+class AESKeyCandidate:
+    key_hex: str
+    key_bits: int
+    memory_offset: int
+    validation: str = "expanded AES key schedule match; decryption not yet verified"
+
+    def to_dict(self) -> dict:
+        return asdict(self)
+
+
+def _xor_word(left: bytes, right: bytes) -> bytes:
+    return bytes(a ^ b for a, b in zip(left, right))
+
+
+def _sub_word(word: bytes) -> bytes:
+    return bytes(SBOX[value] for value in word)
+
+
+def _rot_word(word: bytes) -> bytes:
+    return word[1:] + word[:1]
+
+
+def expand_aes_key(key: bytes) -> bytes:
+    if len(key) not in (16, 24, 32):
+        raise ValueError("AES key must be 128, 192, or 256 bits")
+    nk = len(key) // 4
+    nr = nk + 6
+    words = [key[index : index + 4] for index in range(0, len(key), 4)]
+    target_words = 4 * (nr + 1)
+    for index in range(nk, target_words):
+        temp = words[index - 1]
+        if index % nk == 0:
+            transformed = bytearray(_sub_word(_rot_word(temp)))
+            transformed[0] ^= RCON[index // nk]
+            temp = bytes(transformed)
+        elif nk > 6 and index % nk == 4:
+            temp = _sub_word(temp)
+        words.append(_xor_word(words[index - nk], temp))
+    return b"".join(words)
+
+
+def _first_expanded_word(key: bytes) -> bytes:
+    """Cheap prefilter before expanding an entire schedule at every memory offset."""
+    words = [key[index : index + 4] for index in range(0, len(key), 4)]
+    temp = bytearray(_sub_word(_rot_word(words[-1])))
+    temp[0] ^= RCON[1]
+    return _xor_word(words[0], bytes(temp))
+
+
+def scan_aes_key_schedules(
+    data: bytes,
+    base_offset: int = 0,
+    alignment: int = 4,
+    max_candidates: int = 32,
+) -> list[AESKeyCandidate]:
+    """Find expanded AES schedules; raw random 16/32-byte strings are not accepted."""
+    if alignment < 1:
+        raise ValueError("alignment must be positive")
+    candidates: list[AESKeyCandidate] = []
+    seen: set[bytes] = set()
+    minimum_schedule = 64
+    for offset in range(0, max(0, len(data) - minimum_schedule + 1), alignment):
+        for key_size in (16, 24, 32):
+            if offset + max(minimum_schedule, key_size + 16) > len(data):
+                continue
+            key = data[offset : offset + key_size]
+            if key in seen or len(set(key)) < max(6, key_size // 3):
+                continue
+            if data[offset + key_size : offset + key_size + 4] != _first_expanded_word(
+                key
+            ):
+                continue
+            expanded = expand_aes_key(key)
+            compare_length = min(len(expanded), len(data) - offset, 96)
+            if data[offset : offset + compare_length] != expanded[:compare_length]:
+                continue
+            seen.add(key)
+            candidates.append(
+                AESKeyCandidate(
+                    key_hex=key.hex(),
+                    key_bits=key_size * 8,
+                    memory_offset=base_offset + offset,
+                )
+            )
+            if len(candidates) >= max_candidates:
+                return candidates
+    return candidates
diff --git a/src/cvds/cleanup.py b/src/cvds/cleanup.py
